<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1" context="{'lang': 'fr_FR'}">

    <record id="survey_satisfaction_j30" model="survey.survey">
        <field name="title">Enquête de satisfaction à J+30</field>
        <field name="survey_type">custom</field>
        <field name="access_mode">token</field>
        <field name="users_login_required">False</field>
        <field name="scoring_type">no_scoring</field>
        <field name="questions_layout">page_per_question</field>
        <field name="description">Merci d'avoir rejoint La Villa Nova il y a un mois ! Ton retour nous aide à améliorer l'accueil des futurs collaborateurs.</field>
    </record>

    <record id="survey_satisfaction_j30_q1" model="survey.question">
        <field name="survey_id" ref="survey_satisfaction_j30"/>
        <field name="sequence">1</field>
        <field name="title">Comment évalues-tu ton accueil global ?</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Excellent', 'sequence': 1}),
            (0, 0, {'value': 'Bon', 'sequence': 2}),
            (0, 0, {'value': 'Moyen', 'sequence': 3}),
            (0, 0, {'value': 'Insuffisant', 'sequence': 4}),
        ]"/>
    </record>

    <record id="survey_satisfaction_j30_q2" model="survey.question">
        <field name="survey_id" ref="survey_satisfaction_j30"/>
        <field name="sequence">2</field>
        <field name="title">As-tu compris les valeurs et les attentes de La Villa Nova ?</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Oui, tout à fait', 'sequence': 1}),
            (0, 0, {'value': 'Plutôt oui', 'sequence': 2}),
            (0, 0, {'value': 'Plutôt non', 'sequence': 3}),
            (0, 0, {'value': 'Pas du tout', 'sequence': 4}),
        ]"/>
    </record>

    <record id="survey_satisfaction_j30_q3" model="survey.question">
        <field name="survey_id" ref="survey_satisfaction_j30"/>
        <field name="sequence">3</field>
        <field name="title">Les outils mis à disposition sont-ils suffisants ?</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Oui', 'sequence': 1}),
            (0, 0, {'value': 'Non', 'sequence': 2}),
        ]"/>
    </record>

    <record id="survey_satisfaction_j30_q4" model="survey.question">
        <field name="survey_id" ref="survey_satisfaction_j30"/>
        <field name="sequence">4</field>
        <field name="title">Ton parrain / ta marraine t'a-t-il/elle été utile ?</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Oui, beaucoup', 'sequence': 1}),
            (0, 0, {'value': 'Un peu', 'sequence': 2}),
            (0, 0, {'value': 'Pas vraiment', 'sequence': 3}),
            (0, 0, {'value': &quot;Je n'ai pas eu de parrain/marraine&quot;, 'sequence': 4}),
        ]"/>
    </record>

    <record id="survey_satisfaction_j30_q5" model="survey.question">
        <field name="survey_id" ref="survey_satisfaction_j30"/>
        <field name="sequence">5</field>
        <field name="title">As-tu rencontré des difficultés particulières ?</field>
        <field name="question_type">text_box</field>
    </record>

    <record id="survey_satisfaction_j30_q6" model="survey.question">
        <field name="survey_id" ref="survey_satisfaction_j30"/>
        <field name="sequence">6</field>
        <field name="title">Suggestions pour améliorer l'onboarding ?</field>
        <field name="question_type">text_box</field>
    </record>

    </data>
</odoo>
