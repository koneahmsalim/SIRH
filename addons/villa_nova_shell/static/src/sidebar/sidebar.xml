<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="villa_nova_shell.Sidebar">
        <aside class="vn-rail d-print-none" t-if="!this.ui.isSmall">
            <a class="vn-rail-brand" href="/odoo" title="Accueil">
                <img class="vn-rail-brand-mark" src="/villa_nova_theme/static/src/img/icon_mark.png" alt=""/>
            </a>

            <button class="vn-rail-search" t-on-click="openSearch" title="Rechercher (Ctrl+K)">
                <i class="fa fa-search"/>
            </button>

            <nav class="vn-rail-apps" role="navigation" aria-label="Applications">
                <t t-foreach="apps" t-as="app" t-key="app.id">
                    <a class="vn-rail-app-item"
                       t-att-class="{'vn-active': isCurrentApp(app)}"
                       t-att-href="getMenuItemHref(app)"
                       t-att-data-menu-xmlid="app.xmlid"
                       t-on-click.prevent="() => this.onAppClick(app)"
                       t-att-title="app.name">
                        <img t-if="app.webIconData" t-att-src="app.webIconData" class="vn-rail-app-icon" alt=""/>
                        <span class="vn-rail-active-indicator"/>
                    </a>
                </t>
            </nav>

            <div class="vn-rail-footer">
                <UserMenu/>
            </div>
        </aside>
    </t>

</templates>
