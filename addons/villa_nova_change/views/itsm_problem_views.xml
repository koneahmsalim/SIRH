<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itsm_problem_view_list" model="ir.ui.view">
        <field name="name">itsm.problem.list</field>
        <field name="model">itsm.problem</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == 'critical'" decoration-info="state == 'known_error'">
                <field name="name"/>
                <field name="subject"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="priority" widget="badge"
                       decoration-danger="priority == 'critical'" decoration-warning="priority == 'high'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'known_error'" decoration-success="state in ('resolved','closed')"/>
                <field name="incident_count"/>
            </list>
        </field>
    </record>

    <record id="itsm_problem_view_form" model="ir.ui.view">
        <field name="name">itsm.problem.form</field>
        <field name="model">itsm.problem</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_start_investigation" string="Démarrer l'investigation"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button type="object" name="action_mark_known_error" string="Marquer comme erreur connue"
                            invisible="state != 'investigating'"/>
                    <button type="object" name="action_resolve" string="Marquer comme résolu"
                            invisible="state not in ('investigating', 'known_error')"/>
                    <button type="object" name="action_close" string="Clôturer"
                            invisible="state not in ('resolved',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,investigating,known_error,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_incidents" class="oe_stat_button" icon="fa-bug">
                            <field string="Incidents" name="incident_count" widget="statinfo"/>
                        </button>
                        <button type="object" name="action_view_changes" class="oe_stat_button" icon="fa-wrench">
                            <field string="Changements" name="change_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Erreur connue" bg_color="text-bg-info" invisible="not is_known_error"/>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1><field name="subject" placeholder="ex. Pannes réseau récurrentes le matin"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="is_known_error" invisible="1"/>
                            <field name="resolved_date" readonly="1"/>
                            <field name="closed_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Cause racine" name="root_cause">
                            <field name="root_cause"/>
                        </page>
                        <page string="Solution de contournement" name="workaround">
                            <field name="workaround"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="itsm_problem_view_search" model="ir.ui.view">
        <field name="name">itsm.problem.search</field>
        <field name="model">itsm.problem</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="team_id"/>
                <filter string="Erreurs connues" name="known_errors" domain="[('is_known_error', '=', True)]"/>
                <filter string="Ouverts" name="open" domain="[('state', 'not in', ['resolved', 'closed'])]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Équipe" name="group_team" context="{'group_by': 'team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="itsm_problem_action" model="ir.actions.act_window">
        <field name="name">Problèmes</field>
        <field name="res_model">itsm.problem</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un problème</p>
            <p>Un problème regroupe la cause racine derrière un ou plusieurs incidents récurrents.</p>
        </field>
    </record>
</odoo>
