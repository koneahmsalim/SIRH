<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Favicon : marque Infinity Africa Group plutot que l'icone Odoo. -->
    <template id="layout_favicon" inherit_id="web.layout">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/villa_nova_theme/static/src/img/favicon.ico'</attribute>
        </xpath>
    </template>

    <!-- La page de connexion passe par le module "website" (installe pour
         le portail de recrutement), qui remplace entierement web.login_layout
         par un t-call="website.layout" + <div class="oe_website_login_container">
         - la carte/logo d'origine que ce module ciblait auparavant n'existe
         donc plus dans le rendu final. Un essai de restylage CSS cible de
         cette page a ete abandonne (le fichier n'etait jamais inclus dans le
         bundle compile malgre plusieurs purges de cache - cause non
         identifiee). Le logo de marque est deja repris automatiquement par
         l'entete du site (res.company.logo, cf. hooks.py). -->
</odoo>
