<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_base_automation_itsm_manager" model="ir.rule">
            <field name="name">Règles d'automatisation - tickets ITSM uniquement (admin ITSM)</field>
            <field name="model_id" ref="base_automation.model_base_automation"/>
            <field name="domain_force">[('model_name', '=', 'itsm.ticket')]</field>
            <field name="groups" eval="[(4, ref('group_itsm_manager'))]"/>
        </record>
        <record id="rule_ir_actions_server_itsm_manager" model="ir.rule">
            <field name="name">Actions des règles d'automatisation - tickets ITSM uniquement (admin ITSM)</field>
            <field name="model_id" ref="base.model_ir_actions_server"/>
            <field name="domain_force">[('base_automation_id.model_name', '=', 'itsm.ticket')]</field>
            <field name="groups" eval="[(4, ref('group_itsm_manager'))]"/>
        </record>
    </data>
</odoo>
