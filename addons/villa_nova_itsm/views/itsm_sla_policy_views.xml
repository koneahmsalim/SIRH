<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_sla_policy_view_list" model="ir.ui.view">
        <field name="name">itsm.sla.policy.view.list</field>
        <field name="model">itsm.sla.policy</field>
        <field name="arch" type="xml">
            <list string="Politiques SLA">
                <field name="name"/>
                <field name="calendar_id"/>
            </list>
        </field>
    </record>

    <record id="itsm_sla_policy_view_form" model="ir.ui.view">
        <field name="name">itsm.sla.policy.view.form</field>
        <field name="model">itsm.sla.policy</field>
        <field name="arch" type="xml">
            <form string="Politique SLA">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="calendar_id"/>
                    </group>
                    <field name="description"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="priority"/>
                            <field name="first_response_hours"/>
                            <field name="resolution_hours"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_sla_policy_action" model="ir.actions.act_window">
        <field name="name">Politiques SLA</field>
        <field name="res_model">itsm.sla.policy</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
