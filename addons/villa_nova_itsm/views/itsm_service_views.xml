<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_service_view_list" model="ir.ui.view">
        <field name="name">itsm.service.view.list</field>
        <field name="model">itsm.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="name"/>
                <field name="category_id"/>
                <field name="owner_team_id"/>
                <field name="ticket_count"/>
            </list>
        </field>
    </record>

    <record id="itsm_service_view_form" model="ir.ui.view">
        <field name="name">itsm.service.view.form</field>
        <field name="model">itsm.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="owner_team_id"/>
                        <field name="default_sla_policy_id"/>
                        <field name="requires_approval"/>
                        <field name="icon"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">itsm.service</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
