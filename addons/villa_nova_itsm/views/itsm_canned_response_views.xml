<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_canned_response_view_list" model="ir.ui.view">
        <field name="name">itsm.canned.response.view.list</field>
        <field name="model">itsm.canned.response</field>
        <field name="arch" type="xml">
            <list string="Réponses prédéfinies">
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="itsm_canned_response_view_form" model="ir.ui.view">
        <field name="name">itsm.canned.response.view.form</field>
        <field name="model">itsm.canned.response</field>
        <field name="arch" type="xml">
            <form string="Réponse prédéfinie">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                    </group>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_canned_response_action" model="ir.actions.act_window">
        <field name="name">Réponses prédéfinies</field>
        <field name="res_model">itsm.canned.response</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
