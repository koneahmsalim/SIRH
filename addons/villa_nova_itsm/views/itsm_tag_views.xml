<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_tag_view_list" model="ir.ui.view">
        <field name="name">itsm.tag.view.list</field>
        <field name="model">itsm.tag</field>
        <field name="arch" type="xml">
            <list string="Étiquettes" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="itsm_tag_action" model="ir.actions.act_window">
        <field name="name">Étiquettes</field>
        <field name="res_model">itsm.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
