<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_base_automation_form_villa_nova_itsm" model="ir.ui.view">
        <field name="name">base.automation.form.villa.nova.itsm</field>
        <field name="model">base.automation</field>
        <field name="inherit_id" ref="base_automation.view_base_automation_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="action_server_ids" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <page name="actions" position="attributes">
                <attribute name="string">Actions (lecture seule - modifiable par un administrateur)</attribute>
            </page>
        </field>
    </record>

    <record id="action_villa_nova_itsm_automation_rules" model="ir.actions.act_window">
        <field name="name">Règles d'automatisation</field>
        <field name="res_model">base.automation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model_name', '=', 'itsm.ticket')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune règle d'automatisation pour l'instant</p>
            <p>Ex. « Quand un ticket devient critique, notifier le responsable d'équipe ».</p>
        </field>
    </record>

    <record id="action_villa_nova_itsm_automation_rules_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="base_automation.view_base_automation_tree"/>
        <field name="act_window_id" ref="action_villa_nova_itsm_automation_rules"/>
    </record>

    <record id="action_villa_nova_itsm_automation_rules_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_base_automation_form_villa_nova_itsm"/>
        <field name="act_window_id" ref="action_villa_nova_itsm_automation_rules"/>
    </record>

    <menuitem id="menu_villa_nova_itsm_automation_rules" name="Règles d'automatisation"
              parent="itsm_menu_config_root" action="action_villa_nova_itsm_automation_rules"
              groups="villa_nova_itsm.group_itsm_manager" sequence="7"/>
</odoo>
