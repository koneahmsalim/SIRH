<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_team_view_list" model="ir.ui.view">
        <field name="name">itsm.team.view.list</field>
        <field name="model">itsm.team</field>
        <field name="arch" type="xml">
            <list string="Équipes">
                <field name="name"/>
                <field name="leader_id"/>
                <field name="member_count"/>
                <field name="open_ticket_count"/>
            </list>
        </field>
    </record>

    <record id="itsm_team_view_form" model="ir.ui.view">
        <field name="name">itsm.team.view.form</field>
        <field name="model">itsm.team</field>
        <field name="arch" type="xml">
            <form string="Équipe">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-ticket">
                            <field name="open_ticket_count" widget="statinfo" string="Tickets ouverts"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="leader_id"/>
                        <field name="member_ids" widget="many2many_tags"/>
                        <field name="calendar_id"/>
                        <field name="default_sla_policy_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_team_action" model="ir.actions.act_window">
        <field name="name">Équipes</field>
        <field name="res_model">itsm.team</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
