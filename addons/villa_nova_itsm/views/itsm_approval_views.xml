<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_approval_view_list" model="ir.ui.view">
        <field name="name">itsm.approval.view.list</field>
        <field name="model">itsm.approval</field>
        <field name="arch" type="xml">
            <list string="Approbations" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'refused'">
                <field name="ticket_id"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge"/>
                <button name="action_approve" string="Approuver" type="object" icon="fa-check" invisible="state != 'pending'"/>
                <button name="action_refuse" string="Refuser" type="object" icon="fa-times" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="itsm_approval_view_form" model="ir.ui.view">
        <field name="name">itsm.approval.view.form</field>
        <field name="model">itsm.approval</field>
        <field name="arch" type="xml">
            <form string="Approbation">
                <header>
                    <button name="action_approve" string="Approuver" type="object" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_refuse" string="Refuser" type="object" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="ticket_id"/>
                        <field name="requested_by"/>
                        <field name="approver_id"/>
                        <field name="request_date"/>
                        <field name="decision_date" invisible="not decision_date"/>
                    </group>
                    <field name="comment" placeholder="Commentaire (optionnel)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="itsm_approval_action_my" model="ir.actions.act_window">
        <field name="name">Mes approbations</field>
        <field name="res_model">itsm.approval</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approver_id', '=', uid)]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="itsm_approval_view_search" model="ir.ui.view">
        <field name="name">itsm.approval.view.search</field>
        <field name="model">itsm.approval</field>
        <field name="arch" type="xml">
            <search string="Approbations">
                <field name="ticket_id"/>
                <filter string="En attente" name="pending" domain="[('state','=','pending')]"/>
                <filter string="Traitées" name="done" domain="[('state','!=','pending')]"/>
            </search>
        </field>
    </record>

</odoo>
