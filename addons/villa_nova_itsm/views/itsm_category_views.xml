<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itsm_category_view_list" model="ir.ui.view">
        <field name="name">itsm.category.view.list</field>
        <field name="model">itsm.category</field>
        <field name="arch" type="xml">
            <list string="Catégories">
                <field name="complete_name" string="Catégorie"/>
                <field name="default_team_id"/>
                <field name="ticket_count"/>
            </list>
        </field>
    </record>

    <record id="itsm_category_view_form" model="ir.ui.view">
        <field name="name">itsm.category.view.form</field>
        <field name="model">itsm.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="default_team_id"/>
                        <field name="default_sla_policy_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="itsm_category_action" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">itsm.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_parent_id': False}</field>
    </record>

</odoo>
