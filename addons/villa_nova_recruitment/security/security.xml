<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="group_direction_generale" model="res.groups">
        <field name="name">Direction Générale (PDG)</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="comment">Membres habilités à valider les postes et les decisions finales du processus de recrutement (Etapes 1, 4 et 5 de la procedure RH).</field>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
    </record>

    <!-- Portail candidat : compte obligatoire pour postuler, restreint a ses
         propres candidatures (aucune visibilite sur les autres candidats, ni
         sur le backend Odoo). -->
    <record id="hr_applicant_rule_portal" model="ir.rule">
        <field name="name">Candidature : uniquement ses propres candidatures</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="domain_force">[('candidate_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="hr_candidate_rule_portal" model="ir.rule">
        <field name="name">Candidat : uniquement sa propre fiche</field>
        <field name="model_id" ref="hr_recruitment.model_hr_candidate"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    </data>
</odoo>
