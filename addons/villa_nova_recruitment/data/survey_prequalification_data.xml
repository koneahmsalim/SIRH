<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1" context="{'lang': 'fr_FR'}">

    <record id="survey_prequalification" model="survey.survey">
        <field name="title">Test de préqualification en ligne - Villa Nova</field>
        <field name="survey_type">recruitment</field>
        <field name="access_mode">token</field>
        <field name="users_login_required">False</field>
        <field name="scoring_type">scoring_with_answers</field>
        <field name="questions_layout">page_per_section</field>
        <field name="description">Merci de compléter ce test de préqualification. Il fait partie de l'étape 3 (Réception et sélection des candidatures) de la procédure de recrutement Villa Nova. Comptez environ 15 minutes.</field>
    </record>

    <!-- Page 1 : Logique et raisonnement -->
    <record id="survey_prequalification_p1" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="is_page">True</field>
        <field name="sequence">1</field>
        <field name="title">Logique et raisonnement</field>
    </record>

    <record id="survey_prequalification_p1_q1" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="page_id" ref="survey_prequalification_p1"/>
        <field name="sequence">2</field>
        <field name="title">Complétez la suite logique : 2, 4, 8, 16, ... ?</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': '20', 'sequence': 1}),
            (0, 0, {'value': '24', 'sequence': 2}),
            (0, 0, {'value': '32', 'sequence': 3, 'is_correct': True, 'answer_score': 1}),
            (0, 0, {'value': '30', 'sequence': 4}),
        ]"/>
    </record>

    <record id="survey_prequalification_p1_q2" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="page_id" ref="survey_prequalification_p1"/>
        <field name="sequence">3</field>
        <field name="title">Si tous les Zorbs sont des Klaxs, et que certains Klaxs sont des Vims, peut-on affirmer que certains Zorbs sont des Vims ?</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Oui, toujours', 'sequence': 1}),
            (0, 0, {'value': 'Non, on ne peut pas l\'affirmer avec certitude', 'sequence': 2, 'is_correct': True, 'answer_score': 1}),
            (0, 0, {'value': 'Impossible à déterminer sans plus d\'information sur les Vims', 'sequence': 3}),
        ]"/>
    </record>

    <!-- Page 2 : Culture generale / technique -->
    <record id="survey_prequalification_p2" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="is_page">True</field>
        <field name="sequence">4</field>
        <field name="title">Culture générale et technique</field>
    </record>

    <record id="survey_prequalification_p2_q1" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="page_id" ref="survey_prequalification_p2"/>
        <field name="sequence">5</field>
        <field name="title">Selon vous, quel est aujourd'hui le principal enjeu du secteur dans lequel se situe le poste auquel vous postulez ?</field>
        <field name="question_type">text_box</field>
    </record>

    <!-- Page 3 : Alignement avec les valeurs Villa Nova -->
    <record id="survey_prequalification_p3" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="is_page">True</field>
        <field name="sequence">6</field>
        <field name="title">Alignement avec les valeurs de Villa Nova</field>
    </record>

    <record id="survey_prequalification_p3_q1" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="page_id" ref="survey_prequalification_p3"/>
        <field name="sequence">7</field>
        <field name="title">Décrivez une situation professionnelle où vous avez dû faire preuve de rigueur ou d'intégrité, et comment vous avez agi.</field>
        <field name="question_type">text_box</field>
    </record>

    <record id="survey_prequalification_p3_q2" model="survey.question">
        <field name="survey_id" ref="survey_prequalification"/>
        <field name="page_id" ref="survey_prequalification_p3"/>
        <field name="sequence">8</field>
        <field name="title">Qu'est-ce qui vous motive dans ce poste et chez Villa Nova en particulier ?</field>
        <field name="question_type">text_box</field>
    </record>

    </data>
</odoo>
