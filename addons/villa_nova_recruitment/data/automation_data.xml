<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0" context="{'lang': 'fr_FR'}">

    <!-- Etape 3 : des qu'une candidature entre dans "Test de prequalification en ligne",
         le test est envoye automatiquement au candidat, sans action RH. -->
    <record id="automation_send_prequalification_test" model="base.automation">
        <field name="name">Villa Nova - Envoi auto du test de préqualification</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="stage_test_prequalification"/>
        <field name="active">True</field>
    </record>

    <record id="automation_send_prequalification_test_action" model="ir.actions.server">
        <field name="name">Envoyer le test de préqualification</field>
        <field name="base_automation_id" ref="automation_send_prequalification_test"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <!-- Etapes 4 et 5 : notification candidat + tache assignee, une regle par etape -->
    <record id="automation_notify_prequalification_telephonique" model="base.automation">
        <field name="name">Villa Nova - Notif. préqualification téléphonique</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="hr_recruitment.stage_job2"/>
        <field name="active">True</field>
    </record>
    <record id="automation_notify_prequalification_telephonique_action" model="ir.actions.server">
        <field name="name">Notifier le candidat + tâche RH</field>
        <field name="base_automation_id" ref="automation_notify_prequalification_telephonique"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <record id="automation_notify_entretien_structure" model="base.automation">
        <field name="name">Villa Nova - Notif. entretien structuré</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="hr_recruitment.stage_job3"/>
        <field name="active">True</field>
    </record>
    <record id="automation_notify_entretien_structure_action" model="ir.actions.server">
        <field name="name">Notifier le candidat + tâche Manager</field>
        <field name="base_automation_id" ref="automation_notify_entretien_structure"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <record id="automation_notify_tests_pratiques" model="base.automation">
        <field name="name">Villa Nova - Notif. tests pratiques</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="stage_tests_pratiques"/>
        <field name="active">True</field>
    </record>
    <record id="automation_notify_tests_pratiques_action" model="ir.actions.server">
        <field name="name">Notifier le candidat + tâche Manager</field>
        <field name="base_automation_id" ref="automation_notify_tests_pratiques"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <record id="automation_notify_entretien_president" model="base.automation">
        <field name="name">Villa Nova - Notif. entretien Président</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="stage_entretien_president"/>
        <field name="active">True</field>
    </record>
    <record id="automation_notify_entretien_president_action" model="ir.actions.server">
        <field name="name">Notifier le candidat + tâche Direction Générale</field>
        <field name="base_automation_id" ref="automation_notify_entretien_president"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <record id="automation_notify_verification_references" model="base.automation">
        <field name="name">Villa Nova - Notif. vérification des références</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="stage_verification_references"/>
        <field name="active">True</field>
    </record>
    <record id="automation_notify_verification_references_action" model="ir.actions.server">
        <field name="name">Notifier le candidat + tâche RH</field>
        <field name="base_automation_id" ref="automation_notify_verification_references"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <!-- Etape 6 : offre d'emploi -->
    <record id="automation_notify_offre" model="base.automation">
        <field name="name">Villa Nova - Notif. offre d'emploi</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="hr_recruitment.stage_job4"/>
        <field name="active">True</field>
    </record>
    <record id="automation_notify_offre_action" model="ir.actions.server">
        <field name="name">Envoyer l'offre + tâche RH</field>
        <field name="base_automation_id" ref="automation_notify_offre"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <!-- Etape 6 : formalisation / integration (contrat signe) -->
    <record id="automation_process_hiring" model="base.automation">
        <field name="name">Villa Nova - Formalisation / intégration</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="hr_recruitment.stage_job5"/>
        <field name="active">True</field>
    </record>
    <record id="automation_process_hiring_action" model="ir.actions.server">
        <field name="name">Bienvenue + fiche employé + tâche contrat</field>
        <field name="base_automation_id" ref="automation_process_hiring"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_schedule_notification()</field>
    </record>

    <!-- Protection anti glisser-depose accidentel : les regles ci-dessus ne font
         que programmer la notification (voir action_villa_nova_schedule_notification).
         Ce cron l'envoie reellement apres le delai de grace, et seulement si le
         candidat est toujours a l'etape concernee. -->
    <record id="ir_cron_process_pending_notifications" model="ir.cron">
        <field name="name">Villa Nova - Envoi différé des notifications de recrutement</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_stage_notifications()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="time.strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>

    </data>
</odoo>
