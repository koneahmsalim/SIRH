    <record id="automation_notify_verification_references_action" model="ir.actions.server">
        <field name="name">Notifier le candidat + tâche RH</field>
        <field name="base_automation_id" ref="automation_notify_verification_references"/>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">records.action_villa_nova_notify_stage()</field>
    </record>

    </data>
</odoo>
