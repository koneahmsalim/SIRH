    </record>

    <record id="automation_notify_verification_references" model="base.automation">
        <field name="name">Villa Nova - Notif. vérification des références</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" ref="stage_verification_references"/>
