<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="hr_job_view_form_villa_nova" model="ir.ui.view">
        <field name="name">hr.job.form.villa.nova.planification</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_submit_for_validation" type="object" string="Soumettre pour validation"
                        class="oe_highlight" invisible="x_validation_state != 'draft'"/>
                <button name="action_validate_job" type="object" string="Valider (Direction Générale)"
                        class="oe_highlight" invisible="x_validation_state != 'to_validate'"
                        groups="villa_nova_recruitment.group_direction_generale"/>
                <button name="action_reset_to_draft" type="object" string="Remettre en brouillon"
                        invisible="x_validation_state == 'draft'"/>
                <field name="x_validation_state" widget="statusbar" statusbar_visible="draft,to_validate,validated"/>
            </xpath>

            <!-- Nommage des onglets : "Recrutement" et "Planification du
                 recrutement" coexistaient et se confondaient a la lecture, et un
                 onglet "Fiche de poste" a l'interieur de ce qui EST la fiche de
                 poste n'aidait pas. Chaque onglet porte desormais le nom de ce
                 qu'il contient reellement. Le premier onglet est cible par index
                 car deux pages partagent le meme attribut name="recruitment_page"
                 (hr_recruitment en ajoute une seconde) : un selecteur par nom
                 serait ambigu. -->
            <xpath expr="(//page[@name='recruitment_page'])[1]" position="attributes">
                <attribute name="string">Poste et diffusion</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Besoin et budget" name="villa_nova_planification">
                    <group>
                        <group name="villa_nova_motif" string="Identification du besoin">
                            <!-- Non obligatoire a la saisie : un poste peut n'exister que
                                 pour structurer l'organisation, sans recrutement associe.
                                 Le motif n'est exige qu'a la soumission pour validation
                                 (cf. action_submit_for_validation). -->
                            <field name="x_motif_recrutement"/>
                            <field name="x_delai_souhaite"/>
                            <field name="x_date_cloture"/>
                            <field name="x_budget_recrutement"/>
                            <field name="x_currency_id" invisible="1"/>
                        </group>
                        <group name="villa_nova_objectifs" string="Objectifs">
                            <field name="x_objectifs_3_mois"/>
                            <field name="x_objectifs_1_an"/>
                        </group>
                    </group>
                </page>
                <!-- "Competences attendues" n'est volontairement PAS repris ici :
                     le position="move" sur skill_ids ne retirait pas le champ de
                     son emplacement d'origine (un module charge ensuite l'y
                     remet), si bien que la meme liste de competences etait
                     rendue DEUX fois dans le formulaire - d'autant plus visible
                     quand le poste en portait 85. Les competences restent donc a
                     leur emplacement natif, dans l'onglet "Poste et diffusion". -->
                <page string="Descriptif et profil" name="villa_nova_fiche_poste">
                    <group string="Description du poste">
                        <field name="description" position="move"/>
                    </group>
                    <group string="Profil recherché">
                        <field name="requirements" nolabel="1"
                               placeholder="Diplômes, expérience, qualités requises..."/>
                    </group>
                </page>
            </xpath>

            <!-- Le contenu de "Job Summary" (description) est deplace dans notre
                 onglet "Fiche de poste" ci-dessus au lieu d'etre duplique : on
                 masque l'onglet devenu vide. -->
            <page name="job_description_page" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>

            <!-- Le champ "Cible" (nombre de recrutements) est dans une div.o_row
                 flex avec le texte "nouveaux employes" a cote, sans
                 white-space:nowrap : des que la colonne se resserre (fenetre
                 etroite, panneau lateral ouvert...), le texte se casse mot par
                 mot ("nouveaux" / "employes" sur deux lignes empilees) au lieu
                 de rester groupe - signale par l'utilisateur sur une capture
                 d'ecran ou le champ semblait "etroit". Le span garde
                 maintenant sa phrase entiere sur une seule ligne. -->
            <xpath expr="//div[@name='recruitment_target']/span" position="attributes">
                <attribute name="class">text-nowrap</attribute>
            </xpath>

        </field>
    </record>

    <!-- Le bouton "Nouveau" ouvrait jusque-la une popup minimaliste (nom + alias)
         qui redirigeait ensuite vers le kanban des candidatures, obligeant la RH
         a rouvrir le poste via Configuration pour renseigner motif/budget/objectifs :
         un seul flux desormais, la fiche complete directement, sans redirection
         forcee vers un autre ecran a la sauvegarde. -->
    <record id="hr_recruitment.create_job_simple" model="ir.actions.act_window">
        <field name="view_id" ref="hr.view_hr_job_form"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <!-- Le module website_hr_recruitment ajoute un bouton "Published" directement
         cliquable sur la carte kanban, qui contournait entierement la validation
         Direction Generale. On le rend en lecture seule tant que le poste n'est
         pas valide (le garde-fou reel est cote serveur, voir hr_job.py write()). -->
    <record id="hr_job_view_kanban_villa_nova_readonly_publish" model="ir.ui.view">
        <field name="name">hr.job.kanban.villa.nova.readonly.publish</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.view_hr_job_kanban"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <field name="is_published" position="attributes">
                <attribute name="readonly">x_validation_state != 'validated'</attribute>
            </field>

            <!-- Le circuit de validation (Brouillon -> DG -> Validé) n'existait
                 que dans le formulaire : depuis le kanban, impossible de voir
                 quels postes attendent une validation sans les ouvrir un par un.
                 Le badge n'apparait que pour les deux etats qui appellent une
                 action ; un poste valide n'en porte pas, le bandeau "PUBLIÉ"
                 natif disant deja l'essentiel - on ajoute du signal, pas une
                 pastille de plus sur chaque carte. -->
            <xpath expr="//div[hasclass('o_kanban_card_header_title')]" position="inside">
                <div class="mt-1" invisible="x_validation_state == 'validated'">
                    <span class="badge text-bg-secondary"
                          invisible="x_validation_state != 'draft'">Brouillon</span>
                    <span class="badge text-bg-warning"
                          invisible="x_validation_state != 'to_validate'">À valider par la DG</span>
                </div>
            </xpath>
        </field>
    </record>

    </data>
</odoo>
