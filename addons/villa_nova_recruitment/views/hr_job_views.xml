<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="hr_job_view_form_villa_nova" model="ir.ui.view">
        <field name="name">hr.job.form.villa.nova.planification</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_submit_for_validation" type="object" string="Soumettre pour validation"
                        class="oe_highlight" invisible="x_validation_state != 'draft'"/>
                <button name="action_validate_job" type="object" string="Valider (Direction Générale)"
                        class="oe_highlight" invisible="x_validation_state != 'to_validate'"
                        groups="villa_nova_recruitment.group_direction_generale"/>
                <button name="action_reset_to_draft" type="object" string="Remettre en brouillon"
                        invisible="x_validation_state == 'draft'"/>
                <field name="x_validation_state" widget="statusbar" statusbar_visible="draft,to_validate,validated"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Planification du recrutement" name="villa_nova_planification">
                    <group>
                        <group name="villa_nova_motif" string="Identification du besoin">
                            <field name="x_motif_recrutement" required="1"/>
                            <field name="x_delai_souhaite"/>
                            <field name="x_date_cloture"/>
                            <field name="x_budget_recrutement"/>
                            <field name="x_currency_id" invisible="1"/>
                        </group>
                        <group name="villa_nova_objectifs" string="Objectifs">
                            <field name="x_objectifs_3_mois"/>
                            <field name="x_objectifs_1_an"/>
                        </group>
                    </group>
                </page>
                <page string="Fiche de poste" name="villa_nova_fiche_poste">
                    <group string="Description du poste">
                        <field name="description" position="move"/>
                    </group>
                    <group string="Profil recherché">
                        <field name="requirements" nolabel="1"
                               placeholder="Diplômes, expérience, qualités requises..."/>
                    </group>
                    <group string="Compétences attendues">
                        <field name="skill_ids" position="move"/>
                    </group>
                </page>
            </xpath>

            <!-- Le contenu de "Job Summary" (description) est deplace dans notre
                 onglet "Fiche de poste" ci-dessus au lieu d'etre duplique : on
                 masque l'onglet devenu vide. -->
            <page name="job_description_page" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>

        </field>
    </record>

    <!-- Le bouton "Nouveau" ouvrait jusque-la une popup minimaliste (nom + alias)
         qui redirigeait ensuite vers le kanban des candidatures, obligeant la RH
         a rouvrir le poste via Configuration pour renseigner motif/budget/objectifs :
         un seul flux desormais, la fiche complete directement, sans redirection
         forcee vers un autre ecran a la sauvegarde. -->
    <record id="hr_recruitment.create_job_simple" model="ir.actions.act_window">
        <field name="view_id" ref="hr.view_hr_job_form"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <!-- Le module website_hr_recruitment ajoute un bouton "Published" directement
         cliquable sur la carte kanban, qui contournait entierement la validation
         Direction Generale. On le rend en lecture seule tant que le poste n'est
         pas valide (le garde-fou reel est cote serveur, voir hr_job.py write()). -->
    <record id="hr_job_view_kanban_villa_nova_readonly_publish" model="ir.ui.view">
        <field name="name">hr.job.kanban.villa.nova.readonly.publish</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.view_hr_job_kanban"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <field name="is_published" position="attributes">
                <attribute name="readonly">x_validation_state != 'validated'</attribute>
            </field>
        </field>
    </record>

    </data>
</odoo>
