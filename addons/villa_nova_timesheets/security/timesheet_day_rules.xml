<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cloturer sa journee est une declaration personnelle : sans cette
             regle, n'importe quel collaborateur pourrait declarer terminee la
             journee d'un collegue, et declencher en son nom la notification au
             responsable. Les approbateurs, eux, voient tout (regle ci-dessous)
             pour pouvoir suivre et rouvrir une journee si necessaire. -->
        <record id="villa_nova_timesheet_day_rule_own" model="ir.rule">
            <field name="name">Clôture quotidienne : la sienne uniquement</field>
            <field name="model_id" ref="model_villa_nova_timesheet_day"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="villa_nova_timesheet_day_rule_approver" model="ir.rule">
            <field name="name">Clôture quotidienne : accès complet des approbateurs</field>
            <field name="model_id" ref="model_villa_nova_timesheet_day"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_timesheet.group_hr_timesheet_approver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
