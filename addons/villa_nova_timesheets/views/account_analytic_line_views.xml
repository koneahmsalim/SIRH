<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_timesheet_line_tree_villa_nova" model="ir.ui.view">
        <field name="name">account.analytic.line.list.villa.nova</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="arch" type="xml">
            <field name="task_id" position="after">
                <field name="villa_nova_allowed_activity_ids" column_invisible="True"/>
                <field name="villa_nova_activity_id" string="Code activité"
                       options="{'no_create_edit': True}" readonly="readonly_timesheet"/>
                <field name="villa_nova_billability" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="hr_timesheet_line_search_villa_nova" model="ir.ui.view">
        <field name="name">account.analytic.line.search.villa.nova</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="villa_nova_activity_id" string="Code activité"/>
            </field>
        </field>
    </record>

    <!-- "Mes feuilles de temps" regroupees par semaine par defaut, plutot que
         filtrees sur la seule semaine en cours : on retire "search_default_week"
         (qui limitait deja l'affichage a la semaine courante) et on active le
         regroupement par date au grain semaine. -->
    <record id="hr_timesheet.act_hr_timesheet_line" model="ir.actions.act_window">
        <field name="context">{
            "is_timesheet": 1,
            "is_my_timesheets": 1,
            "group_by": ["date:week"],
        }</field>
    </record>
</odoo>
