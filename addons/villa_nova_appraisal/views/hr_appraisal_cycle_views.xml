<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="hr_appraisal_cycle_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.cycle.form</field>
        <field name="model">hr.appraisal.cycle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_launch" type="object" string="Lancer le cycle"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Clôturer"
                            invisible="state != 'launched'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,launched,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hr_appraisal_evaluation)d" type="action"
                                class="oe_stat_button" icon="fa-list"
                                context="{'search_default_cycle_id': id}">
                            <field name="evaluation_count" widget="statinfo" string="Évaluations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Évaluation trimestrielle T1 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="eval_type"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Objectifs du cycle (SMART / OKR)" name="objectifs">
                            <field name="objectifs_text" placeholder="Objectifs déclinés par département, poste et niveau de responsabilité..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hr_appraisal_cycle_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.cycle.list</field>
        <field name="model">hr.appraisal.cycle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="eval_type"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="evaluation_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hr_appraisal_cycle" model="ir.actions.act_window">
        <field name="name">Cycles d'évaluation</field>
        <field name="res_model">hr.appraisal.cycle</field>
        <field name="view_mode">list,form</field>
    </record>

    </data>
</odoo>
