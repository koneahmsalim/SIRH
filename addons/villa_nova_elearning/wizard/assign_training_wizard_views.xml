<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_villa_nova_assign_training_wizard_form" model="ir.ui.view">
        <field name="name">villa.nova.elearning.assign.wizard.form</field>
        <field name="model">villa.nova.elearning.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assigner une formation obligatoire">
                <group>
                    <field name="course_id" readonly="context.get('default_course_id')"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="due_date"/>
                </group>
                <footer>
                    <button string="Assigner" name="action_assign" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_villa_nova_assign_training_wizard" model="ir.actions.act_window">
        <field name="name">Assigner une formation obligatoire</field>
        <field name="res_model">villa.nova.elearning.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_slide_channel_form_villa_nova_assign" model="ir.ui.view">
        <field name="name">slide.channel.view.form.villa.nova.assign</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">
            <button name="action_channel_enroll" position="after">
                <button string="Assigner (obligatoire)" type="action"
                        name="%(action_villa_nova_assign_training_wizard)d"
                        context="{'default_course_id': id}"
                        class="btn btn-secondary"
                        groups="website_slides.group_website_slides_officer"/>
            </button>
        </field>
    </record>

</odoo>
