<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_villa_nova_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">villa.nova.attendance.report.wizard.form</field>
        <field name="model">villa.nova.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport de présence">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="late_threshold" widget="float_time"/>
                    </group>
                    <group>
                        <field name="report_type"/>
                        <field name="group_by" widget="radio" options="{'horizontal': True}"/>
                        <field name="department_id"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_csv" type="object" string="Exporter en CSV" class="btn-secondary"/>
                    <button name="action_export_pdf" type="object" string="Exporter en PDF" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_villa_nova_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Rapport de présence</field>
        <field name="res_model">villa.nova.attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_villa_nova_attendance_report"
              name="Rapport de présence"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_villa_nova_attendance_report_wizard"
              sequence="17"/>

</odoo>
