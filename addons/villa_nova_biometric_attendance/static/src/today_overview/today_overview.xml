<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="villa_nova_biometric_attendance.TodayOverview">
        <div class="vn-today">
            <div class="vn-today-header">
                <h1>Aujourd'hui</h1>
                <span t-if="state.date" class="vn-today-date" t-esc="state.date"/>
            </div>

            <div t-if="state.deviceAlert" class="vn-today-device-down">
                <i class="fa fa-plug"/>
                <div>
                    <b>Boîtier de pointage injoignable<t t-if="state.deviceSince"> depuis le <t t-esc="state.deviceSince"/></t>.</b>
                    <div>Aucun pointage ne remonte tant que la liaison n'est pas rétablie.
                    Les salariés ci-dessous ne sont pas nécessairement absents : leurs badgeages
                    sont conservés dans la mémoire du boîtier et seront repris automatiquement
                    à la reconnexion.</div>
                </div>
            </div>

            <div t-if="state.loading" class="vn-today-columns">
                <t t-foreach="[1,2,3,4,5]" t-as="i" t-key="i">
                    <span class="vn-skeleton" style="height: 240px; border-radius: var(--vn-radius-lg);"/>
                </t>
            </div>

            <div t-elif="state.isHoliday" class="vn-empty-state">
                <p>Jour férié ou chômé pour l'ensemble de l'entreprise.</p>
            </div>

            <div t-else="" class="vn-today-columns">
                <div class="vn-card vn-today-col">
                    <div class="vn-today-col-head">
                        <span class="vn-badge vn-badge-success" t-esc="state.present.length"/>
                        <h2>Présents</h2>
                    </div>
                    <div t-if="!state.present.length" class="vn-today-col-empty">Personne pour l'instant.</div>
                    <div t-foreach="state.present" t-as="emp" t-key="emp.id"
                         class="vn-today-row" t-on-click="() => this.openEmployee(emp.id)" role="button">
                        <span class="vn-today-row-name" t-esc="emp.name"/>
                        <div class="vn-today-row-meta">
                            <span class="vn-today-row-dept" t-esc="emp.department"/>
                            <span class="vn-today-row-time" t-esc="this.formatTime(emp.check_in)"/>
                        </div>
                    </div>
                </div>

                <div class="vn-card vn-today-col">
                    <div class="vn-today-col-head">
                        <span class="vn-badge vn-badge-danger" t-esc="state.late.length"/>
                        <h2>En retard</h2>
                    </div>
                    <div t-if="!state.late.length" class="vn-today-col-empty">Aucun retard aujourd'hui.</div>
                    <div t-foreach="state.late" t-as="emp" t-key="emp.id"
                         class="vn-today-row" t-on-click="() => this.openEmployee(emp.id)" role="button">
                        <span class="vn-today-row-name" t-esc="emp.name"/>
                        <div class="vn-today-row-meta">
                            <span class="vn-today-row-dept" t-esc="emp.department"/>
                            <span class="vn-today-row-time" t-esc="this.formatTime(emp.check_in)"/>
                        </div>
                    </div>
                </div>

                <div class="vn-card vn-today-col" t-att-class="{'vn-today-col-unreliable': state.deviceAlert}">
                    <div class="vn-today-col-head">
                        <span class="vn-badge vn-badge-neutral" t-esc="state.absent.length"/>
                        <h2>Absents</h2>
                        <span t-if="state.deviceAlert" class="vn-today-col-caveat"
                              title="Le boîtier ne répond plus : cette liste ne peut pas être considérée comme fiable.">non fiable</span>
                    </div>
                    <div t-if="!state.absent.length" class="vn-today-col-empty">Tout le monde a pointé.</div>
                    <div t-foreach="state.absent" t-as="emp" t-key="emp.id"
                         class="vn-today-row" t-on-click="() => this.openEmployee(emp.id)" role="button">
                        <span class="vn-today-row-name" t-esc="emp.name"/>
                        <span class="vn-today-row-dept" t-esc="emp.department"/>
                    </div>
                </div>

                <div class="vn-card vn-today-col">
                    <div class="vn-today-col-head">
                        <span class="vn-badge vn-badge-info" t-esc="state.onLeave.length"/>
                        <h2>En congé</h2>
                    </div>
                    <div t-if="!state.onLeave.length" class="vn-today-col-empty">Personne en congé aujourd'hui.</div>
                    <div t-foreach="state.onLeave" t-as="emp" t-key="emp.id"
                         class="vn-today-row" t-on-click="() => this.openLeave(emp.leave_id)" role="button">
                        <span class="vn-today-row-name" t-esc="emp.name"/>
                        <span class="vn-today-row-dept" t-esc="emp.leave_type"/>
                    </div>
                </div>

                <div class="vn-card vn-today-col" title="Aucun identifiant boîtier renseigné - n'a jamais pu pointer, indépendamment de sa présence réelle">
                    <div class="vn-today-col-head">
                        <span class="vn-badge vn-badge-warning" t-esc="state.unregistered.length"/>
                        <h2>Non enregistrés</h2>
                    </div>
                    <div t-if="!state.unregistered.length" class="vn-today-col-empty">Tout le monde est relié au boîtier.</div>
                    <div t-foreach="state.unregistered" t-as="emp" t-key="emp.id"
                         class="vn-today-row" t-on-click="() => this.openEmployee(emp.id)" role="button">
                        <span class="vn-today-row-name" t-esc="emp.name"/>
                        <span class="vn-today-row-dept" t-esc="emp.department"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
