<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="endpoint_enrollment_key_view_list" model="ir.ui.view">
        <field name="name">itsm.endpoint.enrollment.key.list</field>
        <field name="model">itsm.endpoint.enrollment.key</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="public_id"/>
                <field name="agent_count"/>
                <field name="max_uses"/>
                <field name="expiry_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="endpoint_enrollment_key_view_form" model="ir.ui.view">
        <field name="name">itsm.endpoint.enrollment.key.form</field>
        <field name="model">itsm.endpoint.enrollment.key</field>
        <field name="arch" type="xml">
            <form string="Clé d'enrôlement">
                <header>
                    <button name="action_generate_key" type="object" string="Générer un jeton"
                            class="btn-primary"
                            confirm="Un nouveau jeton sera généré et l'ancien sera invalidé immédiatement. Les agents déjà enrôlés ne sont pas affectés. Continuer ?"/>
                    <button name="action_revoke" type="object" string="Révoquer" invisible="not active"
                            confirm="Les agents déjà enrôlés avec cette clé restent actifs (leur secret est indépendant) - seule l'admission de NOUVEAUX agents avec cette clé sera bloquée. Continuer ?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(villa_nova_endpoint.action_endpoint_agent)d" type="action"
                                class="oe_stat_button" icon="fa-laptop"
                                context="{'search_default_enrollment_key_id': id}">
                            <field name="agent_count" widget="statinfo" string="Agents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Révoquée" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="public_id" readonly="1"/>
                        <field name="active" invisible="1"/>
                        <field name="max_uses"/>
                        <field name="expiry_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_endpoint_enrollment_key" model="ir.actions.act_window">
        <field name="name">Clés d'enrôlement</field>
        <field name="res_model">itsm.endpoint.enrollment.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smile">
                Créez une clé d'enrôlement à intégrer dans l'installateur de l'agent
                (déploiement manuel, GPO ou MSI) - une même clé peut servir à plusieurs postes.
            </p>
        </field>
    </record>
</odoo>
