<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="remote_command_view_list" model="ir.ui.view">
        <field name="name">itsm.remote.command.list</field>
        <field name="model">itsm.remote.command</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('failed', 'refused')" decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="command_type"/>
                <field name="is_sensitive" widget="boolean_toggle" readonly="1"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-danger="state in ('failed', 'refused')"
                       decoration-info="state in ('pending', 'sent', 'running')"
                       decoration-warning="state == 'pending_approval'"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="remote_command_view_form" model="ir.ui.view">
        <field name="name">itsm.remote.command.form</field>
        <field name="model">itsm.remote.command</field>
        <field name="arch" type="xml">
            <form string="Commande à distance">
                <header>
                    <button name="action_submit" type="object" string="Soumettre" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Cette action sera transmise à l'agent endpoint du poste concerné (ou soumise à approbation si sensible). Continuer ?"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state not in ('draft', 'pending_approval', 'pending', 'sent')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,pending,sent,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <widget name="web_ribbon" title="Sensible" bg_color="text-bg-warning" invisible="not is_sensitive"/>
                    <group>
                        <group>
                            <field name="equipment_id" readonly="state != 'draft'"/>
                            <field name="agent_id" readonly="1"/>
                            <field name="command_type" readonly="state != 'draft'"/>
                            <field name="parameters" readonly="state != 'draft'"
                                   placeholder="Nom du service, ou message à afficher"/>
                            <field name="is_sensitive" readonly="1"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="approval_id" readonly="1" invisible="not approval_id"/>
                            <field name="sent_date" readonly="1" invisible="not sent_date"/>
                            <field name="started_date" readonly="1" invisible="not started_date"/>
                            <field name="completed_date" readonly="1" invisible="not completed_date"/>
                        </group>
                    </group>
                    <group string="Résultat" invisible="not result_output and not result_error">
                        <field name="result_output" readonly="1" nolabel="1" invisible="not result_output"/>
                        <field name="result_error" readonly="1" nolabel="1" invisible="not result_error" class="text-danger"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="remote_command_view_search" model="ir.ui.view">
        <field name="name">itsm.remote.command.search</field>
        <field name="model">itsm.remote.command</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="command_type"/>
                <field name="requested_by"/>
                <filter name="mine" string="Mes demandes" domain="[('requested_by', '=', uid)]"/>
                <filter name="sensitive" string="Sensibles" domain="[('is_sensitive', '=', True)]"/>
                <filter name="awaiting_approval" string="En attente d'approbation" domain="[('state', '=', 'pending_approval')]"/>
                <filter name="in_progress" string="En cours" domain="[('state', 'in', ('pending', 'sent', 'running'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="Statut" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type de commande" context="{'group_by': 'command_type'}"/>
                    <filter name="group_equipment" string="Actif" context="{'group_by': 'equipment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_remote_command" model="ir.actions.act_window">
        <field name="name">Commandes à distance</field>
        <field name="res_model">itsm.remote.command</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smile">
                Aucune commande à distance pour l'instant - créez-en une depuis un actif
                disposant d'un agent endpoint enrôlé.
            </p>
        </field>
    </record>
</odoo>
