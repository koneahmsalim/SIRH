<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.villa_nova_endpoint</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Endpoint Management" string="Endpoint Management" name="villa_nova_endpoint"
                     groups="villa_nova_itam.group_itam_manager">
                    <block title="Contrôle à distance" name="villa_nova_endpoint_remote_control_setting_container">
                        <setting string="MeshCentral" help="Odoo ouvre seulement ce lien par poste - le partage d'écran est entièrement géré par votre serveur MeshCentral auto-hébergé.">
                            <field name="meshcentral_url_template"
                                   placeholder="https://mesh.example.com/?viewmode=13&amp;gotonode={node_id}"/>
                            <div class="text-muted">
                                {node_id} est remplacé par l'identifiant MeshCentral du poste.
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
