<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_endpoint_refresh_checkin_status" model="ir.cron">
            <field name="name">Endpoint : rafraîchir la connectivité des agents</field>
            <field name="model_id" ref="model_itsm_endpoint_agent"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_checkin_status()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_endpoint_alert_offline_agents" model="ir.cron">
            <field name="name">Endpoint : alerter sur les agents hors ligne prolongés</field>
            <field name="model_id" ref="model_itsm_endpoint_agent"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_offline_agents()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
