<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itsm_change_view_pivot" model="ir.ui.view">
        <field name="name">itsm.change.pivot</field>
        <field name="model">itsm.change</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="change_type" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="itsm_change_view_graph" model="ir.ui.view">
        <field name="name">itsm.change.graph</field>
        <field name="model">itsm.change</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="risk_level"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="villa_nova_change.itsm_change_action" model="ir.actions.act_window">
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
</odoo>
