<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itam_equipment_view_form_contract" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.contract</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="villa_nova_itam.itam_equipment_view_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" name="button_box" position="inside">
                <button type="object" name="action_view_contracts" class="oe_stat_button" icon="fa-file-text-o">
                    <field string="Contrats" name="contract_count" widget="statinfo"/>
                </button>
            </div>
            <field name="invoice_reference" position="after">
                <field name="purchase_order_id"/>
            </field>
        </field>
    </record>
</odoo>
