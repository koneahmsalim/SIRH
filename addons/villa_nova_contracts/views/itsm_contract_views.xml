<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itsm_contract_view_list" model="ir.ui.view">
        <field name="name">itsm.contract.list</field>
        <field name="model">itsm.contract</field>
        <field name="arch" type="xml">
            <list decoration-danger="renewal_status == 'expired'" decoration-warning="renewal_status == 'expiring_soon'">
                <field name="name"/>
                <field name="contract_type"/>
                <field name="vendor_id"/>
                <field name="end_date"/>
                <field name="renewal_status" widget="badge"
                       decoration-success="renewal_status == 'valid'"
                       decoration-warning="renewal_status == 'expiring_soon'"
                       decoration-danger="renewal_status == 'expired'"
                       decoration-muted="renewal_status == 'none'"/>
                <field name="cost"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <record id="itsm_contract_view_form" model="ir.ui.view">
        <field name="name">itsm.contract.form</field>
        <field name="model">itsm.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_equipment" class="oe_stat_button" icon="fa-laptop">
                            <field string="Actifs" name="equipment_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expiré" bg_color="text-bg-danger"
                            invisible="renewal_status != 'expired'"/>
                    <widget name="web_ribbon" title="Expire bientôt" bg_color="text-bg-warning"
                            invisible="renewal_status != 'expiring_soon'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Support Dell PowerEdge - contrat annuel"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type"/>
                            <field name="vendor_id"/>
                            <field name="reference"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="cost"/>
                            <field name="auto_renew"/>
                            <field name="purchase_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Actifs et licences couverts" name="coverage">
                            <field name="equipment_ids" widget="many2many_tags"/>
                            <field name="license_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="itsm_contract_view_search" model="ir.ui.view">
        <field name="name">itsm.contract.search</field>
        <field name="model">itsm.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <filter string="Expire bientôt" name="expiring_soon" domain="[('renewal_status', '=', 'expiring_soon')]"/>
                <filter string="Expiré" name="expired" domain="[('renewal_status', '=', 'expired')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Fournisseur" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'contract_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="itsm_contract_action" model="ir.actions.act_window">
        <field name="name">Contrats</field>
        <field name="res_model">itsm.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un contrat</p>
            <p>Support, maintenance, licences - suivez les dates de renouvellement et les actifs couverts.</p>
        </field>
    </record>
</odoo>
