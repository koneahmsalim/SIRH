<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    <!-- Congé maternité : donnée explicitement "confidentiel RH" (Etape a de la
         procedure) - seule la collaboratrice concernee peut lire sa propre fiche,
         personne d'autre que la RH/DG ne doit pouvoir parcourir celles des collegues. -->
    <record id="hr_maternity_process_rule_own" model="ir.rule">
        <field name="name">Congé maternité : uniquement la collaboratrice concernée</field>
        <field name="model_id" ref="model_hr_maternity_process"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="hr_maternity_process_rule_rh" model="ir.rule">
        <field name="name">Congé maternité : accès complet RH/DG</field>
        <field name="model_id" ref="model_hr_maternity_process"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('villa_nova_recruitment.group_direction_generale'))]"/>
    </record>

    <!-- Absence non planifiee : le collaborateur concerne et son manager direct
         (qui recoit des taches sur ce dossier) y ont acces en lecture ; la
         RH/DG conserve seule le droit de modifier/cloturer/supprimer. -->
    <record id="hr_unplanned_absence_rule_own" model="ir.rule">
        <field name="name">Absence non planifiée : le collaborateur ou son manager</field>
        <field name="model_id" ref="model_hr_unplanned_absence"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="hr_unplanned_absence_rule_rh" model="ir.rule">
        <field name="name">Absence non planifiée : accès complet RH/DG</field>
        <field name="model_id" ref="model_hr_unplanned_absence"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('villa_nova_recruitment.group_direction_generale'))]"/>
    </record>

    </data>
</odoo>
