<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="hr_unplanned_absence_view_form" model="ir.ui.view">
        <field name="name">hr.unplanned.absence.form</field>
        <field name="model">hr.unplanned.absence</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_justifiee" type="object" string="Marquer comme justifiée"
                            class="oe_highlight" invisible="state in ('justifiee', 'cloturee')"/>
                    <button name="action_close" type="object" string="Clôturer"
                            invisible="state != 'justifiee'"/>
                    <field name="state" widget="statusbar" statusbar_visible="declaree,justifiee,cloturee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id" placeholder="Collaborateur"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_debut"/>
                            <field name="date_declaration"/>
                        </group>
                        <group>
                            <field name="justificatif_recu"/>
                            <field name="justificatif_deadline" readonly="1"/>
                            <field name="abandon_poste_deadline" readonly="1"/>
                        </group>
                    </group>
                    <field name="motif" placeholder="Motif de l'absence..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hr_unplanned_absence_view_list" model="ir.ui.view">
        <field name="name">hr.unplanned.absence.list</field>
        <field name="model">hr.unplanned.absence</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="date_debut"/>
                <field name="justificatif_recu"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hr_unplanned_absence" model="ir.actions.act_window">
        <field name="name">Absences non planifiées</field>
        <field name="res_model">hr.unplanned.absence</field>
        <field name="view_mode">list,form</field>
    </record>

    </data>
</odoo>
