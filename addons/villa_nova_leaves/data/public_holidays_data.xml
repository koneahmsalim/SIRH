<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Jours feries legaux de Cote d'Ivoire (Code du travail 2015, art. 24.2 ;
         decret 96-205 modifie par le decret 2011-371).

         Aucun calendar_id n'est renseigne : le conge s'applique alors a TOUS
         les horaires de travail, y compris ceux qui seront crees plus tard -
         c'est ce qu'on veut pour un jour ferie national, contrairement a une
         fermeture propre a une equipe.

         Le fuseau de l'entreprise est Africa/Abidjan (UTC+0) : les bornes
         ci-dessous sont donc directement les heures locales, sans decalage.

         noupdate="1" : les quatre fetes musulmanes (Nuit du Destin, Ramadan,
         Tabaski, Maouloud) suivent le calendrier lunaire et sont fixees chaque
         annee par decret, avec un ecart possible d'un a deux jours selon
         l'observation du croissant. Elles se corrigent donc a la main en base
         sans qu'une mise a jour du module ne vienne les ecraser. -->
    <data noupdate="1">

        <!-- ================= 2026 ================= -->

        <record id="ci_holiday_2026_nouvel_an" model="resource.calendar.leaves">
            <field name="name">Jour de l'An</field>
            <field name="date_from">2026-01-01 00:00:00</field>
            <field name="date_to">2026-01-01 23:59:59</field>
        </record>

