<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="ir_cron_check_abandon_poste" model="ir.cron">
        <field name="name">Villa Nova - Vérification absences non justifiées (72h)</field>
        <field name="model_id" ref="model_hr_unplanned_absence"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_abandon_poste()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="time.strftime('%Y-%m-%d %H:%M:%S')"/>
