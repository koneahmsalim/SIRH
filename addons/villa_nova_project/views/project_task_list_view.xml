<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue liste dediee et minimale pour "Mes taches" : les vues natives
         (view_task_tree2 et ses parents) embarquent un default_group_by
         (stade personnel ou stade Kanban) impossible a neutraliser depuis
         l'exterieur, plus une dizaine de colonnes pensees pour un usage
         "toutes les taches" (societe, temps passe, notation, activite
         suivante...). On repart d'un arch propre, sans heritage, pour un
         coup d'oeil propre facon Asana. -->
    <record id="view_task_list_my_tasks" model="ir.ui.view">
        <field name="name">project.task.list.villa.nova.my.tasks</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="0">
                <field name="priority" widget="priority" nolabel="1" width="32px"/>
                <field name="name"/>
                <field name="project_id" options="{'no_open': true}"/>
                <field name="user_ids" widget="many2many_avatar_user" width="90px"/>
                <field name="date_deadline" widget="remaining_days"/>
                <field name="state" widget="project_task_state_selection" options="{'is_toggle_mode': false}"/>
            </list>
        </field>
    </record>

</odoo>
