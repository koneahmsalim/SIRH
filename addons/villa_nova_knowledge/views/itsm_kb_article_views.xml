<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itsm_kb_article_view_kanban" model="ir.ui.view">
        <field name="name">itsm.kb.article.kanban</field>
        <field name="model">itsm.kb.article</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="category_id"/>
                <field name="state"/>
                <field name="view_count"/>
                <field name="helpful_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="name" class="fw-bold"/>
                            <span t-if="record.state.raw_value == 'draft'" class="badge text-bg-secondary">Brouillon</span>
                            <span t-elif="record.state.raw_value == 'archived'" class="badge text-bg-dark">Archivé</span>
                        </div>
                        <div t-if="record.category_id.value" class="text-muted small" t-esc="record.category_id.value"/>
                        <div class="d-flex justify-content-between align-items-center mt-2 text-muted small">
                            <span><i class="fa fa-eye me-1" title="Vues"/><field name="view_count"/></span>
                            <span><i class="fa fa-thumbs-up me-1" title="Utile"/><field name="helpful_count"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="itsm_kb_article_view_list" model="ir.ui.view">
        <field name="name">itsm.kb.article.list</field>
        <field name="model">itsm.kb.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="author_id"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
                <field name="is_public"/>
                <field name="view_count"/>
                <field name="helpful_ratio" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="itsm_kb_article_view_form" model="ir.ui.view">
        <field name="name">itsm.kb.article.form</field>
        <field name="model">itsm.kb.article</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_publish" string="Publier" class="btn-primary"
                            invisible="state == 'published'" groups="villa_nova_itsm.group_itsm_manager"/>
                    <button type="object" name="action_archive_article" string="Archiver"
                            invisible="state != 'published'" groups="villa_nova_itsm.group_itsm_manager"/>
                    <button type="object" name="action_reset_draft" string="Remettre en brouillon"
                            invisible="state != 'archived'" groups="villa_nova_itsm.group_itsm_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Comment se connecter au VPN"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="related_service_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="author_id"/>
                            <field name="is_public"/>
                            <field name="view_count" readonly="1"/>
                            <field name="helpful_count" readonly="1"/>
                            <field name="not_helpful_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="content"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="itsm_kb_article_view_search" model="ir.ui.view">
        <field name="name">itsm.kb.article.search</field>
        <field name="model">itsm.kb.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <filter string="Publiés" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="Brouillons" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Visibles sur le portail" name="public" domain="[('is_public', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Catégorie" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="itsm_kb_article_action" model="ir.actions.act_window">
        <field name="name">Base de connaissances</field>
        <field name="res_model">itsm.kb.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un article</p>
            <p>Guides, procédures et FAQ - suggérés automatiquement sur les tickets de la même catégorie.</p>
        </field>
    </record>
</odoo>
