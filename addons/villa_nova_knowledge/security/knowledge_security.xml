<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pas de nouveau groupe : tout agent ITSM peut contribuer (creer/
             modifier des brouillons), seul un gestionnaire peut publier -
             impose au niveau des vues (bouton "Publier" restreint), les
             droits d'ecriture eux-memes restent partages avec les agents
             pour encourager la contribution. -->

        <record id="itsm_kb_article_rule_portal" model="ir.rule">
            <field name="name">Articles KB : portail - publics et publiés uniquement</field>
            <field name="model_id" ref="model_itsm_kb_article"/>
            <field name="domain_force">[('state', '=', 'published'), ('is_public', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
