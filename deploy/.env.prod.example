# ---------------------------------------------------------------------------
# Variables de production. A copier en deploy/.env SUR LE SERVEUR, jamais ici,
# et jamais dans git : ce fichier-ci ne contient que des exemples.
#
#     cp deploy/.env.prod.example deploy/.env
#     nano deploy/.env
#
# Generer un mot de passe solide :   openssl rand -base64 36
# ---------------------------------------------------------------------------

# --- Base de donnees -------------------------------------------------------
# N'utilisez PAS "odoo/odoo" comme en developpement. PostgreSQL n'est pas
# expose hors du reseau Docker, mais un mot de passe trivial transforme la
# moindre faille applicative en acces complet aux donnees du personnel.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGEZ_MOI_openssl_rand_base64_36

# --- Nom d'hote public -----------------------------------------------------
# Le nom par defaut d'Hostinger convient : c'est un vrai nom DNS, Let's Encrypt
# sait lui delivrer un certificat. Relevez-le avec :  hostname -f
# Exemple : srv123456.hstgr.cloud
# Plus tard, pour passer a sirh.infinity-africa.com, il suffira de changer
# cette ligne et de relancer Caddy.
SIRH_DOMAIN=srvXXXXXX.hstgr.cloud

# --- Adresse pour Let's Encrypt --------------------------------------------
# Sert uniquement aux avertissements d'expiration de certificat. Aucun courriel
# n'est envoye aux employes depuis cette adresse.
SIRH_ADMIN_EMAIL=ahmed.kone@infinity-africa.com
